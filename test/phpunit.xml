<?xml version="1.0" encoding="UTF-8"?>
<phpunit colors="true"
    processIsolation="false"
    stopOnError="false"
    stopOnFailure="false"
    stopOnIncomplete="false"
    stopOnSkipped="false"
    backupGlobals="false"
    bootstrap="./bootstrap.php">
    <testsuites>
        <!-- bootstrap.php guards the default suite; api-scenarios.sh gives the scenario tests ./vendor/autoload.php. -->
        <testsuite name="default">
            <directory suffix='.php'>./tests</directory>
        </testsuite>
        <!-- The shared API scenarios, generated from verification/scenarios/api.json; api-scenarios.sh runs them. -->
        <testsuite name="api-scenarios">
            <directory suffix='Test.php'>./scenarios</directory>
        </testsuite>
    </testsuites>
</phpunit>